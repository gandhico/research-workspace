# ------------------------------------------------------------------------------
# EE 362 - Computer Organization Laboratory
# Lab 1 - Quartus project settings (starter)
#
# You build the Example 1 project BY HAND - that is the point of Example 1.
# This file is provided only for the assignment, so that nobody loses bench
# time to project setup on the very first lab.
#
# HOW TO USE
#   1. Put Lab1.qpf and Lab1.qsf in the same folder as your .vhd files.
#   2. Open Lab1.qpf from Quartus (File > Open Project).
#   3. Everything below is already configured: device, simulator, file list.
#
# IMPORTANT: keep this folder on a SHORT LOCAL PATH with no spaces, e.g.
#   C:\ee362\lab01
# Project paths containing spaces, accented characters, or living inside a
# cloud-synced folder (OneDrive, Dropbox) cause failures that look like
# random Quartus bugs. They are not random.
# ------------------------------------------------------------------------------

set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEMA4U23C6
set_global_assignment -name TOP_LEVEL_ENTITY TransLatch
set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

# --- Device operating conditions (defaults, do not change) --------------------
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "2.5 V"
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"

# --- Simulation: Questa, VHDL -------------------------------------------------
# This is what makes Tools > Run Simulation Tool > RTL Simulation work.
set_global_assignment -name EDA_SIMULATION_TOOL "Questa Altera FPGA (VHDL)"
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT VHDL -section_id eda_simulation
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation

# Run the testbench automatically from Quartus.
set_global_assignment -name EDA_TEST_BENCH_ENABLE_STATUS TEST_BENCH_MODE -section_id eda_simulation
set_global_assignment -name EDA_NATIVELINK_SIMULATION_TEST_BENCH tb_TransLatch -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_NAME tb_TransLatch -section_id eda_simulation
set_global_assignment -name EDA_DESIGN_INSTANCE_NAME NA -section_id tb_TransLatch
set_global_assignment -name EDA_TEST_BENCH_MODULE_NAME tb_TransLatch -section_id tb_TransLatch
set_global_assignment -name EDA_TEST_BENCH_FILE tb_TransLatch.vhd -section_id tb_TransLatch

# --- Design files -------------------------------------------------------------
set_global_assignment -name VHDL_FILE TransLatch.vhd
set_global_assignment -name VHDL_FILE TransLatch8.vhd
set_global_assignment -name VHDL_FILE tb_TransLatch.vhd

set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
