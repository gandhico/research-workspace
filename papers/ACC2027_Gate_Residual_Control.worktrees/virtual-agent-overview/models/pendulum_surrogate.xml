<mujoco model="rotary inverted pendulum surrogate">
  <option timestep="0.001" gravity="0 0 -9.81" integrator="RK4"/>
  <default><joint damping="0.002"/><geom density="500" rgba="0.3 0.5 0.8 1"/></default>
  <worldbody>
    <geom type="plane" size="2 2 .1" rgba=".9 .9 .9 1"/>
    <body name="arm" pos="0 0 .3">
      <joint name="arm_joint" type="hinge" axis="0 0 1"/>
      <geom type="capsule" fromto="0 0 0 .20 0 0" size=".018" mass=".08"/>
      <body name="pendulum" pos=".20 0 0">
        <joint name="pendulum_joint" type="hinge" axis="1 0 0"/>
        <geom type="capsule" fromto="0 0 0 0 0 .30" size=".012" mass=".03" rgba=".8 .3 .2 1"/>
      </body>
    </body>
  </worldbody>
  <actuator><motor name="arm_voltage" joint="arm_joint" ctrlrange="-5 5" gear="0.03"/></actuator>
</mujoco>

